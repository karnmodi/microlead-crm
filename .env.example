# --- PostgreSQL (Prisma) ---
# Runtime: use the host’s pooled URL when available (PgBouncer transaction mode, Supabase pooler, etc.).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/microlead_crm"
# Migrations / introspection: direct connection (required on some hosts; otherwise same as DATABASE_URL).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/microlead_crm"

# --- Redis (BullMQ — apps/worker) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (API) ---
JWT_SECRET="change-me-generate-a-long-random-secret"

# --- Web (browser → API) ---
# Origin only — do not include /v1 (the client adds /v1 automatically).
# NEXT_PUBLIC_API_URL=http://localhost:3001

# --- CORS (API allows this origin) ---
# WEB_ORIGIN=http://localhost:3000

# --- Email (optional — workspace invite emails via Resend) ---
# RESEND_API_KEY=
# RESEND_FROM=onboarding@resend.dev

# --- AI (optional until wired) ---
# Direct OpenAI (local/dev):
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# Azure OpenAI (production-style): set endpoint, deployment name, and key.
# The API uses these when AZURE_OPENAI_API_KEY is set; otherwise falls back to OPENAI_API_KEY.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-02-15-preview
# ANTHROPIC_API_KEY=

# --- Integrations (optional — data enrichment via third-party APIs) ---
# Companies House (UK company register — free API key at https://developer.company-information.service.gov.uk/)
# COMPANIES_HOUSE_API_KEY=
# Optional — override API host (default: https://api.company-information.service.gov.uk)
# COMPANIES_HOUSE_API_BASE_URL=https://api.company-information.service.gov.uk
# Apollo.io (contact & company enrichment)
# APOLLO_API_KEY=
# Hunter.io (email finder)
# HUNTER_API_KEY=
