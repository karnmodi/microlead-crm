generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum ParentEntityType {
  LEAD
  CONTACT
  COMPANY
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum EmailDirection {
  OUTBOUND
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String   @map("password_hash")
  name             String?
  preferredTeamId  String?  @map("preferred_team_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  memberships   TeamMember[]
  invitesCreated TeamInvite[] @relation("InviteCreatedBy")
  ownedLeads    Lead[]       @relation("LeadOwner")
  tasksAssigned Task[]       @relation("TaskAssignee")
  activities    Activity[]
  sentEmails    LeadEmail[]  @relation("LeadEmailSender")

  preferredTeam Team? @relation(fields: [preferredTeamId], references: [id], onDelete: SetNull)

  @@map("users")
}

model Team {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        TeamMember[]
  invites        TeamInvite[]
  companies      Company[]
  contacts       Contact[]
  pipelineStages PipelineStage[]
  leads          Lead[]
  tasks          Task[]
  notes          Note[]
  activities     Activity[]
  attachments    Attachment[]
  leadEmails     LeadEmail[]
  leadSummaries  LeadSummaryCache[]
  aiSettings     TeamAiSettings?
  preferredBy    User[]

  @@map("teams")
}

model TeamAiSettings {
  id                String   @id @default(uuid())
  teamId            String   @unique @map("team_id")
  businessFocus     String?  @map("business_focus")
  crmPurpose        String?  @map("crm_purpose")
  targetAudience    String?  @map("target_audience")
  toneGuidelines    String?  @map("tone_guidelines")
  emailSignature    String?  @map("email_signature")
  defaultClosing    String?  @map("default_closing")
  languageStyle     String?  @map("language_style")
  responseVerbosity Int      @default(2) @map("response_verbosity")
  reasoningDepth    Int      @default(2) @map("reasoning_depth")
  actionHorizonDays Int      @default(7) @map("action_horizon_days")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_ai_settings")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@map("team_members")
}

model TeamInvite {
  id              String    @id @default(uuid())
  teamId          String    @map("team_id")
  email           String
  role            TeamRole  @default(MEMBER)
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  createdByUserId String    @map("created_by_user_id")
  acceptedAt      DateTime? @map("accepted_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([teamId, email])
  @@map("team_invites")
}

model Company {
  id             String    @id @default(uuid())
  teamId         String    @map("team_id")
  name           String
  website        String?
  industry       String?
  description    String?   @db.Text
  employeeCount  Int?      @map("employee_count")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  contacts Contact[]
  leads    Lead[]

  @@index([teamId, updatedAt(sort: Desc)])
  @@map("companies")
}

model Contact {
  id          String    @id @default(uuid())
  teamId      String    @map("team_id")
  companyId   String?   @map("company_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  email       String?
  phone       String?
  jobTitle    String?   @map("job_title")
  linkedinUrl String?   @map("linkedin_url")
  deletedAt   DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  team    Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  leads   Lead[]
  emails  LeadEmail[]

  @@index([teamId, updatedAt(sort: Desc)])
  @@map("contacts")
}

model PipelineStage {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  name      String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  leads Lead[]

  @@index([teamId, sortOrder])
  @@map("pipeline_stages")
}

model Lead {
  id                 String       @id @default(uuid())
  teamId             String       @map("team_id")
  title              String
  description        String?      @db.Text
  value              Decimal?     @db.Decimal(14, 2)
  currency           String       @default("USD")
  probability        Int?
  source             String?
  status             LeadStatus   @default(OPEN)
  expectedCloseDate  DateTime?    @map("expected_close_date")
  closedAt           DateTime?    @map("closed_at")
  lostReason         String?      @map("lost_reason")
  tags               Json?
  priority           LeadPriority @default(MEDIUM)
  stageId            String       @map("stage_id")
  companyId          String?      @map("company_id")
  contactId          String?      @map("contact_id")
  ownerId            String?      @map("owner_id")
  aiSummaryVersion   Int          @default(0) @map("ai_summary_version")
  deletedAt          DateTime?    @map("deleted_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  team    Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  stage   PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  company Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner   User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  summary LeadSummaryCache?
  emails  LeadEmail[]

  @@index([teamId, updatedAt(sort: Desc)])
  @@index([teamId, stageId])
  @@index([teamId, ownerId])
  @@index([teamId, status])
  @@index([teamId, expectedCloseDate])
  @@map("leads")
}

model LeadSummaryCache {
  id            String   @id @default(uuid())
  teamId        String   @map("team_id")
  leadId        String   @unique @map("lead_id")
  sourceVersion Int      @map("source_version")
  summary       String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([teamId, leadId, updatedAt(sort: Desc)])
  @@map("lead_summary_cache")
}

model LeadEmail {
  id                String         @id @default(uuid())
  teamId            String         @map("team_id")
  leadId            String         @map("lead_id")
  contactId         String?        @map("contact_id")
  actorUserId       String         @map("actor_user_id")
  direction         EmailDirection @default(OUTBOUND)
  emailTo           String         @map("email_to")
  subject           String
  bodyText          String         @map("body_text") @db.Text
  provider          String
  providerMessageId String?        @map("provider_message_id")
  sentAt            DateTime       @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  lead     Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  actor    User    @relation("LeadEmailSender", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([teamId, leadId, sentAt(sort: Desc)])
  @@index([teamId, contactId, sentAt(sort: Desc)])
  @@map("lead_emails")
}

model Task {
  id          String           @id @default(uuid())
  teamId      String           @map("team_id")
  parentType  ParentEntityType @map("parent_type")
  parentId    String           @map("parent_id")
  title       String
  done        Boolean          @default(false)
  assigneeId  String?          @map("assignee_id")
  dueAt       DateTime?        @map("due_at")
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([teamId, parentType, parentId])
  @@map("tasks")
}

model Note {
  id         String           @id @default(uuid())
  teamId     String           @map("team_id")
  parentType ParentEntityType @map("parent_type")
  parentId   String           @map("parent_id")
  body       String
  deletedAt  DateTime?        @map("deleted_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, parentType, parentId])
  @@map("notes")
}

model Activity {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  actorUserId String   @map("actor_user_id")
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  action      String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  team  Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([teamId, entityType, entityId, createdAt(sort: Desc)])
  @@map("activities")
}

model Attachment {
  id               String           @id @default(uuid())
  teamId           String           @map("team_id")
  parentType       ParentEntityType @map("parent_type")
  parentId         String           @map("parent_id")
  storageKey       String           @map("storage_key")
  mimeType         String           @map("mime_type")
  size             Int
  filename         String?
  extractedText    String?          @map("extracted_text") @db.Text
  extractionStatus String?          @map("extraction_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, parentType, parentId])
  @@index([teamId, extractionStatus])
  @@map("attachments")
}
